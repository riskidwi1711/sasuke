FABRIC_ORGS=Org1MSP,Org2MSP

# Role → Org mapping
FABRIC_ROLE_ADMIN_MSP=Org1MSP
FABRIC_ROLE_USER_MSP=Org2MSP

# Org1 configuration
FABRIC_ORG_Org1MSP_CCP_PATH=../organizations/peerOrganizations/org1.example.com/connection-org1.json
FABRIC_ORG_Org1MSP_WALLET_PATH=./wallet/org1
FABRIC_ORG_Org1MSP_IDENTITY=appUserOrg1
FABRIC_ORG_Org1MSP_CERT_PATH=../organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/User1@org1.example.com-cert.pem
FABRIC_ORG_Org1MSP_KEY_PATH=../organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk

# Org2 configuration
FABRIC_ORG_Org2MSP_CCP_PATH=../organizations/peerOrganizations/org2.example.com/connection-org2.json
FABRIC_ORG_Org2MSP_WALLET_PATH=./wallet/org2
FABRIC_ORG_Org2MSP_IDENTITY=appUserOrg2
FABRIC_ORG_Org2MSP_CERT_PATH=../organizations/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp/signcerts/User1@org2.example.com-cert.pem
FABRIC_ORG_Org2MSP_KEY_PATH=../organizations/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp/keystore/priv_sk

# Channel & Chaincode
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=asset-contract

# Discovery
FABRIC_DISCOVERY_ENABLED=true
FABRIC_DISCOVERY_ASLOCALHOST=true

# API server
PORT=3000

# Logging
# LOG_LEVEL: error|warn|info|debug|trace
LOG_LEVEL=info
# LOG_FORMAT: text|json
LOG_FORMAT=text
# LOG_REQUEST_BODY: 'true' to include request bodies (truncated)
LOG_REQUEST_BODY=false
# LOG_REQUEST_BODY_MAX: max bytes of body to log when enabled
LOG_REQUEST_BODY_MAX=2048
